MESSAGE user "Uç donanımlar için C++20 standardında std::span ve concepts kullanan küçük ve güvenli bir Memory Arena sınıfı yaz."
MESSAGE assistant "Uç donanımlarda `malloc` ve `new` gibi dinamik bellek tahsislerinden bellek parçalanması (fragmentation) ve deterministik olmayan gecikmeler nedeniyle kaçınırız. Aşağıda C++20 `concepts`, `std::span` ve `alignas(64)` önbellek hizalaması kullanan deterministik `MemoryArena` sınıfı yer almaktadır:

```cpp
#include <cstddef>
#include <cstdint>
#include <span>
#include <concepts>
#include <array>

namespace kam::core {

template <typename T>
concept TrivialArenaType = std::is_trivially_copyable_v<T> && (alignof(T) <= 64);

template <size_t CapacityBytes = 65536>
class alignas(64) MemoryArena {
private:
    alignas(64) std::array<std::byte, CapacityBytes> buffer_{};
    size_t offset_{0};

public:
    constexpr MemoryArena() noexcept = default;

    template <TrivialArenaType T>
    [[nodiscard]] std::span<T> allocate(size_t count = 1) noexcept {
        const size_t align_mask = alignof(T) - 1;
        const size_t aligned_offset = (offset_ + align_mask) & ~align_mask;
        const size_t bytes_needed = sizeof(T) * count;

        if (aligned_offset + bytes_needed > CapacityBytes) {
            return std::span<T>{};
        }

        offset_ = aligned_offset + bytes_needed;
        T* ptr = reinterpret_cast<T*>(buffer_.data() + aligned_offset);
        return std::span<T>(ptr, count);
    }

    constexpr void reset() noexcept { offset_ = 0; }
    [[nodiscard]] constexpr size_t used_bytes() const noexcept { return offset_; }
};

} // namespace kam::core
```"

MESSAGE user "UART-2 koptuğunda SDR 868MHz hattına geçiş yapan AST Sandbox uyumlu bir C++20 JIT modülü yaz."
MESSAGE assistant "UART-2 telemetri kesintisinde İki Aşamalı AST Güvenlik Sandboxing kurallarına tam uyumlu, sıfır dinamik bellek tahsisatlı (`alignas(64)`) C++20 JIT kurtarma modülü aşağıdadır:

```cpp
// [KAM-JIT-MUTATION] sdr_fallback_node.cpp
#include <cstdint>
#include <iostream>

namespace kam::recovery {
struct alignas(64) SdrChannelConfig {
    uint32_t center_freq_hz{868000000};
    uint16_t hop_interval_us{250};
    uint8_t  tx_power_dbm{14};
};
} // namespace kam::recovery

extern "C" {
int kam_entrypoint() {
    constexpr kam::recovery::SdrChannelConfig cfg{};
    std::cout << "[SDR-TOPOLOJİ] SDR " << (cfg.center_freq_hz / 1000000)
              << "MHz telemetri köprüsü aktifleştirildi.\n";
    return 0;
}
}
```"

